// Cloudflare Worker for alloyed.osmosis.zone. React Router (framework mode)
// built with Vite. The Cloudflare Vite plugin runs the Worker in workerd for
// local dev and produces the deploy bundle. No cron triggers: the activity
// ingest runs from GitHub Actions.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alloy-dashboard",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-06",
  // nodejs_compat: Prisma, pg (TCP through Cloudflare sockets) and node:*
  // modules. global_fetch_strictly_public: fetches to the site's own public
  // hostname go over the internet rather than looping back into the Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The Vite plugin builds the Worker and ignores wrangler `build.command`.
  // Workers Builds must run `pnpm cf:build` first: that generates the Prisma
  // client, then `react-router build` bundles this file.
  // Data cache for pool overviews, asset lists and charts. Same namespace the
  // OpenNext incremental cache used; keys are prefixed v1: so the old entries
  // are never read.
  "kv_namespaces": [
    {
      "binding": "DATA_CACHE",
      "id": "e038ace0a5d94c6daf71703bc48091f3",
    },
  ],
  "observability": { "enabled": true },
  "vars": {
    // robots.txt only allows indexing when this is "production".
    "SITE_ENV": "production",
  },
  // Pull-request previews require an explicit preview value for every var.
  // Anything but "production" keeps previews out of search.
  "previews": {
    "vars": {
      "SITE_ENV": "preview",
    },
  },
}
