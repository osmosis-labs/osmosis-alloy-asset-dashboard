NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CODE_IDS=814,867,996
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=abcd
MODE=development

# Activity store (optional; Prisma Postgres in production). Without it the pool
# page uses live LCD queries. In production the direct URL is the Worker secret
# POSTGRES_PRISMA_URL and the GitHub Actions secret DATABASE_URL.
# POSTGRES_PRISMA_URL=   (or DATABASE_URL) direct URL, used at runtime
# DATABASE_URL=          direct URL, for the cron, scripts and prisma db push
# The activity cron runs only as `pnpm cron` (the GitHub Actions workflow); it
# supplies its own per-run CRON_SECRET, so none is needed here.

# SQS trade feed for the Recent Swaps table (optional). When set, the table
# pages through GET {SQS_TRADES_URL}/trades/list instead of the activity store
# and live LCD. Server-side only (a Worker var). wrangler.jsonc sets it to
# https://sqs.osmosis.zone, which local dev also picks up: set it empty here
# for the store and LCD table, or for a local SQS: http://localhost:9092
# SQS_TRADES_URL=
