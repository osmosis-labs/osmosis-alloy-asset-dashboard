# Activity store (optional). Set by connecting the Vercel Postgres / Neon store
# to the project; without it the pool page uses live LCD queries.
# POSTGRES_PRISMA_URL=   (or DATABASE_URL) pooled URL, used at runtime
# DATABASE_URL_UNPOOLED= (or POSTGRES_URL_NON_POOLING) direct URL, for prisma db push
# Bearer token Vercel Cron sends to /api/cron/activity.
# CRON_SECRET=
